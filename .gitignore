# Packer
packer/plugins/
packer/manifest.json
*.pkrvars.hcl
!base.pkrvars.hcl

# Python
__pycache__/
*.pyc
.venv/
venv/

# Env
.env
*.pem

# TLS certs
certs/

# Web app local secrets / db
web/secret.key
web/*.db

# Per-installer SSH public key written by scripts/setup-keys.sh.
# Never commit a real key: the public half is matched by a private half that
# grants passwordless ec2-user SSH on every image you build.
ansible/base/vars/golden_user.pub

# Runtime data volume (DB + encryption key)
data/

# OS
.DS_Store

# AWS
.aws/
credentials
# Generated at image build time by scripts/build-version.sh
web/version.json
